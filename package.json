{
  "name": "@topolyte/windows-acl",
  "description": "Windows ACL write-restriction sandbox provider for DeepSeek Harness with NON-BLOCKING workspace grant materialization: the eager inheritable-ACE walk runs in a grant-helper child process (fire-and-forget), so a large workspace's first provision never freezes a command spawn. Installs on the OFFICIAL harness as a ctx.sandbox replacement — no fork required.",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ranecc/topolyte-windows-acl.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./grant": {
      "types": "./lib/grant-cli.d.ts",
      "default": "./lib/grant-cli.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
